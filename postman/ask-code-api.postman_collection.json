    {
      "name": "Этап 2C: сессии",
      "description": "Порядок: создать сессию (sessionId сохраняется) -> список -> задача в сессии -> просмотр -> export -> resume. Для /execute и /start нужен реальный ASK_KEY.",
      "item": [
        {
          "name": "POST /sessions (создать)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));",
            "const j = pm.response.json();",
            "pm.test('session_id', () => pm.expect(j.session_id).to.be.a('string'));",
            "pm.collectionVariables.set('sessionId', j.session_id);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"title\": \"postman demo\" }" },
            "url": "{{baseUrl}}/sessions"
          }
        },
        {
          "name": "GET /sessions",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));",
            "const list = pm.response.json().sessions;",
            "pm.test('sessions - массив', () => pm.expect(list).to.be.an('array'));",
            "pm.test('наша сессия в списке', () => pm.expect(list.map(s => s.id)).to.include(pm.collectionVariables.get('sessionId')));"
          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/sessions" }
        },
        {
          "name": "POST /execute в сессии (SSE)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"prompt\": \"create session-note.txt with the text one\",\n  \"mode\": \"all\",\n  \"session_id\": \"{{sessionId}}\"\n}" },
            "url": "{{baseUrl}}/execute",
            "description": "Перед done приходит event: session {session_id, requests, title}. Вторая такая же задача, пока идёт первая, даёт 409 session_busy."
          }
        },
        {
          "name": "POST /execute в той же сессии (продолжение)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"prompt\": \"in the file you just made, change one to two\",\n  \"mode\": \"all\",\n  \"session_id\": \"{{sessionId}}\"\n}" },
            "url": "{{baseUrl}}/execute",
            "description": "Модель получает историю сессии, поэтому знает, о каком файле речь. В event: session requests станет 2."
          }
        },
        {
          "name": "POST /start в сессии",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));",
            "pm.collectionVariables.set('taskId', pm.response.json().taskId);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"prompt\": \"what did I ask you before? One line.\",\n  \"mode\": \"plan\",\n  \"session_id\": \"{{sessionId}}\"\n}" },
            "url": "{{baseUrl}}/start",
            "description": "Дальше GET /status/{{taskId}}: в ответе будет session_id. 409 session_busy, если в сессии ещё идёт задача."
          }
        },
        {
          "name": "GET /status/:taskId (session_id)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));",
            "pm.test('session_id совпадает', () => pm.expect(pm.response.json().session_id).to.eql(pm.collectionVariables.get('sessionId')));"
          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/status/{{taskId}}" }
        },
        {
          "name": "GET /sessions/:id",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));",
            "const j = pm.response.json();",
