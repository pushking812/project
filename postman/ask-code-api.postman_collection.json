{
  "info": {
    "name": "ask-code API",
    "description": "HTTP/SSE API ask-code-server (этапы 1 и 2A-2C). Запустите сервер (npm start) и импортируйте коллекцию. Этап 1: Health, Me, Ask, Execute, Start -> Status -> Stop (taskId сохраняется автоматически). Этап 2: файлы, заметки и память, сессии (sessionId сохраняется после POST /sessions). Запросы /ask, /execute, /start требуют реальный ключ ASK_KEY.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:8737" },
    { "key": "taskId", "value": "" },
    { "key": "sessionId", "value": "" }
  ],
  "item": [
    {
      "name": "Этап 1: задачи",
      "item": [
        {
          "name": "GET /health",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));",
            "pm.test('ok=true', () => pm.expect(pm.response.json().ok).to.eql(true));",
            "pm.test('keyPresent', () => pm.expect(pm.response.json().keyPresent).to.eql(true));"
          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/health" }
        },
        {
          "name": "GET /me",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));"
          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/me" }
        },
        {
          "name": "POST /ask (SSE)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"prompt\": \"what is in ASK.md? One line.\",\n  \"useContext\": true\n}" },
            "url": "{{baseUrl}}/ask",
            "description": "Поток событий: delta, usage, done | error. Postman покажет поток после завершения ответа."
          }
        },
        {
          "name": "POST /ask - 400 (пустой prompt)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('400', () => pm.response.to.have.status(400));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"prompt\": \"\" }" },
            "url": "{{baseUrl}}/ask"
          }
        },
        {
          "name": "POST /execute (SSE)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"prompt\": \"create hello.txt with the text Hello\",\n  \"mode\": \"all\"\n}" },
            "url": "{{baseUrl}}/execute",
            "description": "Поток: status, delta, tool, usage, done | error. mode: all | edits | plan."
          }
        },
        {
          "name": "POST /execute - 400 (неверный mode)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('400', () => pm.response.to.have.status(400));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"prompt\": \"x\", \"mode\": \"bogus\" }" },
            "url": "{{baseUrl}}/execute"
          }
        },
        {
          "name": "POST /start",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));",
            "const j = pm.response.json();",
            "pm.test('taskId + running', () => { pm.expect(j.taskId).to.be.a('string'); pm.expect(j.status).to.eql('running'); });",
            "pm.collectionVariables.set('taskId', j.taskId);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"prompt\": \"create hello.txt with the text Hello\",\n  \"mode\": \"all\"\n}" },
            "url": "{{baseUrl}}/start",
            "description": "429, если уже идёт ASK_MAX_PARALLEL задач."
          }
        },
        {
          "name": "GET /status/:taskId",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));",
            "pm.test('status valid', () => pm.expect(['running','done','error','stopped']).to.include(pm.response.json().status));"
          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/status/{{taskId}}" }
        },
        {
          "name": "POST /stop/:taskId",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));",
            "pm.test('status valid', () => pm.expect(['stopping','done','error','stopped']).to.include(pm.response.json().status));"
          ] } }],
          "request": { "method": "POST", "url": "{{baseUrl}}/stop/{{taskId}}" }
        },
        {
          "name": "GET /status/unknown - 404",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('404', () => pm.response.to.have.status(404));"
          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/status/no-such-id" }
        },
        {
          "name": "GET /nope - 404",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('404', () => pm.response.to.have.status(404));"
          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/nope" }
        },
        {
          "name": "DELETE /health - 405",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('405', () => pm.response.to.have.status(405));"
          ] } }],
          "request": { "method": "DELETE", "url": "{{baseUrl}}/health" }
        }
      ]
    },
    {
      "name": "Этап 2A: файлы и команды",
      "description": "Прямые операции без модели, ключ ASK_KEY для них не нужен (кроме старта сервера).",
      "item": [
        {
          "name": "POST /write (hello-postman.txt)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 или 409 (файл уже есть)', () => pm.expect([200, 409]).to.include(pm.response.code));",
            "if (pm.response.code === 200) pm.test('есть diff', () => pm.expect(pm.response.json().diff).to.be.an('array'));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"path\": \"hello-postman.txt\",\n  \"content\": \"Hello\\nWorld\\n\",\n  \"overwrite\": false\n}" },
            "url": "{{baseUrl}}/write",
            "description": "overwrite:false - 409 exists, если файл уже есть. Запустите запрос второй раз, чтобы увидеть 409."
          }
        },
        {
          "name": "POST /read",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));",
            "pm.test('ok + output', () => { const j = pm.response.json(); pm.expect(j.ok).to.eql(true); pm.expect(j.output).to.be.a('string'); });"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"path\": \"hello-postman.txt\", \"offset\": 1, \"limit\": 20 }" },
            "url": "{{baseUrl}}/read"
          }
        },
        {
          "name": "POST /edit",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 или 409 (фрагмента уже нет)', () => pm.expect([200, 409]).to.include(pm.response.code));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"path\": \"hello-postman.txt\", \"old_text\": \"World\", \"new_text\": \"Postman\" }" },
            "url": "{{baseUrl}}/edit",
            "description": "409 old_text_not_found, если World уже заменено."
          }
        },
        {
          "name": "POST /list",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"path\": \"\", \"depth\": 1 }" },
            "url": "{{baseUrl}}/list"
          }
        },
        {
          "name": "POST /search",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
