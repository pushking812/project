          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"pattern\": \"Hello\", \"regex\": false }" },
            "url": "{{baseUrl}}/search"
          }
        },
        {
          "name": "POST /command",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));",
            "pm.test('ok', () => pm.expect(pm.response.json().ok).to.eql(true));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"command\": \"node -v\", \"timeout_sec\": 20 }" },
            "url": "{{baseUrl}}/command"
          }
        },
        {
          "name": "POST /read .env - 403",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('403 secret', () => { pm.response.to.have.status(403); pm.expect(pm.response.json().code).to.eql('secret'); });"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"path\": \".env\" }" },
            "url": "{{baseUrl}}/read"
          }
        },
        {
          "name": "POST /read ../ - 403",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
