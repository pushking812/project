# Образец mcp\.env. Скопируйте в mcp\.env (этот файл в .gitignore) и раскомментируйте нужное.
# Формат: KEY=VALUE, без пробелов вокруг "=", кавычки не нужны.
# Уже заданные переменные окружения сильнее .env. Пустые значения игнорируются:
# пустая строка в .env не отключает настройку (чтобы отключить, пишите off там, где это допустимо).
# Читают: server.py (MCP), openai_proxy.py, code_tap.py (TAP_*), telegram_bot.py.
# Значения после "=" ниже — умолчания кода. Строка с умолчанием можно оставить закомментированной.

# --- Ask: сайт ---------------------------------------------------------------
# Ключ сайта. Нужен прокси и режиму legacy; MCP-инструментам (api) не нужен: ключ у Node-сервера (ASK_KEY).
# ASK_API_KEY=sk-ask-...
# ASK_BASE_URL=https://ask.oryxml.com

# --- MCP-сервер (server.py) --------------------------------------------------
# api — инструменты нашего локального API; legacy — прежние (ask, get_usage, code); both — оба набора
# MCP_BACKEND=api
# Адрес нашего API (npm start, без аутентификации)
# ASK_LOCAL_URL=http://127.0.0.1:8737
# HTTP-режим (server.py --http)
# ASK_HOST=127.0.0.1
# ASK_PORT=8000
# Разрешить адреса не с этого компьютера (ASK_HOST, ASK_LOCAL_URL, TELEGRAM_MCP_URL): 1 | true | yes
# ASK_ALLOW_REMOTE=
# Имя сервера и группы инструментов (обычно задаёт run_server.ps1: main = ask, office = ask-extra).
# Группы: office, vba, browser, desktop (скриншоты, нужен Pillow) и др.; неизвестная группа — ошибка.
# Скриншоты могут захватить личные данные: отключить группу — MCP_SKIP_GROUPS=desktop.
# MCP_NAME=ask
# MCP_GROUPS=
# MCP_SKIP_GROUPS=
# Язык подсказок анализа: ru (по умолчанию) или en
# ASK_LANG=ru

# --- Сессии MCP --------------------------------------------------------------
# Автосессия: 0 | false | no | off выключает
# ASK_SESSION_AUTO=true
# ASK_SESSION_ID=
# Файл с id (по умолчанию %APPDATA%\ask-code\mcp-session.json или ~/.config/ask-code/mcp-session.json)
# ASK_SESSION_FILE=

# --- Корни для файловых и Office-инструментов --------------------------------
# ASK_CODE_ROOT=      # legacy; по умолчанию корень проекта
# ASK_OFFICE_ROOT=    # по умолчанию рабочая папка Node-сервера, затем ASK_CODE_ROOT
# Разрешить Office-инструментам пути вне корня: 1
# ASK_OFFICE_ALLOW_ANY_PATH=
# Папка PNG для скриншотов (внутри корня проекта); по умолчанию <корень>/.ask-screenshots
# ASK_SCREENSHOT_DIR=

# --- OpenAI-прокси (openai_proxy.py, см. README «OpenAI-прокси») -------------
# Пароль прокси для клиентов (Cline и др.). Обязателен, не должен совпадать с ASK_API_KEY.
# PROXY_TOKEN=...
# PROXY_HOST=127.0.0.1                  # другой адрес запрещён
# PROXY_PORT=8789
# PROXY_MODEL=claude-sonnet-5-5
# ask | native | mcp | off: чем пользоваться для действий — спросить, родными инструментами клиента, MCP, без подсказки
# PROXY_TOOL_POLICY=ask
# ask — прежний путь через /v1/ask; code — через наш сервер (8737) и /v1/code (опыт)
# PROXY_BACKEND=ask
# Только для PROXY_BACKEND=code: all | edits | plan; не задано — ASK_MODE сервера
# PROXY_CODE_MODE=
# Каталог инструментов
# PROXY_TOOL_EXCLUDE=craft,=composio_,=team_   # серверы (подстрока) и "=префикс" родных инструментов, которых нет в каталоге
# PROXY_TOOL_FIRST=ask__,ask-extra__,ask-office__
# PROXY_SLIM_SCHEMA=on                         # off — не ужимать схемы
# PROXY_TOOLS_BLOCK=60000                      # знаков в каталоге
# PROXY_TOOLS_DUMP=                            # файл со списком инструментов клиента; не задано — mcp\tools-seen.txt; off — не писать
# Размеры
# PROXY_TOOL_RESULT=20000                      # знаков в одном результате инструмента
# PROXY_COMPACT_AT=0.7                         # доля 100000 знаков, с которой история сжимается (0.1–0.95); off — выключено
# Заметки проекта (ASK.md) в запросе
# PROXY_NOTES_FILE=                            # не задано — ASK.md в корне проекта; off — отключить
# PROXY_NOTES_CHARS=4000
# Логи
# PROXY_ACCESS_LOG=on                          # off — не писать строки о входящих запросах
# PROXY_LOG_FILE=                              # не задано — project\proxy.log. Отключить файл можно только переменной окружения: $env:PROXY_LOG_FILE = ''

# --- Перехватчик обмена (code_tap.py) ----------------------------------------
# TAP_PORT=8790
# TAP_SITE=https://ask.oryxml.com
# TAP_DIR=             # по умолчанию project\tap
# TAP_FULL=            # 1 — не резать длинные строки в файле

# --- Проверочные скрипты (client.py, check_mcp.py) ---------------------------
# ASK_URL=http://127.0.0.1:8000/mcp

# --- Telegram-бот (telegram_bot.py, см. docs/telegram-bot.md) ----------------
# TELEGRAM_BOT_TOKEN=123456789:AA...
# TELEGRAM_ALLOWED_USER_IDS=123456789
# TELEGRAM_ALLOWED_CHAT_IDS=           # по умолчанию = список пользователей
# TELEGRAM_ALLOW_ANY=0                 # 1 — пускать всех (только осознанно)
# TELEGRAM_MCP_URL=http://127.0.0.1:8000/mcp   # иначе ASK_URL
# TELEGRAM_ALLOW_REMOTE=0              # 1 — MCP не на этом компьютере
# TELEGRAM_DEFAULT_MODE=plan           # all | edits | plan
# TELEGRAM_ALLOW_DANGEROUS=0           # 1 — запись файлов, команды, очистка памяти
# TELEGRAM_TASK_TIMEOUT=900
# TELEGRAM_POLL_INTERVAL=2.0
# TELEGRAM_ASK_TIMEOUT=600
# TELEGRAM_MAX_MESSAGE=3900
# TELEGRAM_POLL_TIMEOUT=25             # 0–50 с, long polling
# TELEGRAM_LOG_LEVEL=info              # debug | info | warn | error
# Вместо прокси можно указать свой relay к Bot API (Cloudflare Worker и подобные):
# TELEGRAM_API_URL=https://api.telegram.org
# Если api.telegram.org блокируется — прокси только для Telegram (http, https, socks5, socks5h):
# TELEGRAM_PROXY=socks5://127.0.0.1:1080
# TELEGRAM_PROXY_USERNAME=
# TELEGRAM_PROXY_PASSWORD=
# Без TELEGRAM_PROXY бот возьмёт HTTPS_PROXY/ALL_PROXY из окружения, если они заданы.

# --- Не здесь: Node-сервер (npm start) ---------------------------------------
# Он .env не читает; его переменные задаются в окне перед npm start:
# ASK_KEY (обязательна), ASK_SITE=https://ask.oryxml.com, ASK_MODE=all (all | edits | plan),
# ASK_CAPTCHA=manual (manual | handoff), ASK_ROOT, ASK_ALLOWED_ROOTS, ASK_REMEMBER_ROOT=1, ASK_ROOT_FILE,
# ASK_HOST=127.0.0.1, ASK_PORT=8737, ASK_MAX_PARALLEL=3, ASK_LOG_LEVEL=info, ASK_BROWSER, ASK_BROWSER_DIR,
# ASK_BROWSER_HEADLESS=1, ASK_FILES_MAX=5, ASK_FILES_MAX_BYTES=30000000, ASK_OUTPUT_SCAN=1.
# Подробнее: docs/api-stage1.md и docs/api-stage3.md.
