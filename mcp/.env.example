# Бэкенд инструментов: api (по умолчанию) | legacy | both. Подробности в MCP_TOOLS.md.
MCP_BACKEND=api
# Наш HTTP API (ask-code-server). Только этот компьютер, если не задано ASK_ALLOW_REMOTE=1.
ASK_LOCAL_URL=http://127.0.0.1:8737
# Ключ сайта Ask нужен только бэкенду legacy и openai_proxy.py (в бэкенде api он у ask-code-server как ASK_KEY).
ASK_API_KEY=sk-ask-ВАШ_КЛЮЧ
# Прокси для Cline/Continue (openai_proxy.py). PROXY_TOKEN обязателен и НЕ равен ASK_API_KEY:
# это пароль прокси для агента, а не ключ Ask.
PROXY_HOST=127.0.0.1
PROXY_PORT=8789
PROXY_MODEL=claude-sonnet-5-5
PROXY_TOKEN=
